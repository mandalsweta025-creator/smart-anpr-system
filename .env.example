# ─────────────────────────────────────────────────────────────────────────────
# Smart ANPR System — Environment Configuration
# Copy this file to .env and fill in values before first run.
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication ────────────────────────────────────────────────────────────
# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-secrets-token-hex-32

# ── PostgreSQL password (Docker Compose) ──────────────────────────────────────
# Used by both the `db` and `anpr` services in docker-compose.yml.
POSTGRES_PASSWORD=strongpassword

# ── Database URL ──────────────────────────────────────────────────────────────
# Docker Compose (PostgreSQL) — DATABASE_URL is set automatically in docker-compose.yml
# using the POSTGRES_PASSWORD above. Override here only for non-standard topology.
# DATABASE_URL=postgresql+psycopg2://anpr_user:strongpassword@db:5432/anpr_db
#
# SQLite (single-host, bare-metal, no Docker):
# DATABASE_URL=sqlite:////app/db/anpr.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production, set this to your actual frontend URL (e.g. https://anpr.company.com).
CORS_ORIGINS=http://localhost

# ── Storage retention ─────────────────────────────────────────────────────────
# Detection snapshots older than this many days are deleted hourly.
DETECTION_MAX_AGE_DAYS=30

# If total snapshot directory size exceeds this MB, oldest files are removed.
DETECTION_MAX_SIZE_MB=5000

# ── Email alerts (optional) ───────────────────────────────────────────────────
# Leave blank to disable email notifications for CRITICAL/HIGH anomalies.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@company.com
# SMTP_PASSWORD=your-app-password
# ALERT_EMAIL_TO=security@company.com,ops@company.com
